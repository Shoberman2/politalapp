<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for ios/BallotWatch/Secrets.plist, which is gitignored.

  Generate your copy from the repo-root .env:
      ios/scripts/make-secrets.sh

  SUPABASE_URL / SUPABASE_ANON_KEY are required. The anon key is safe in a
  shipped binary (row-level security guards every table, and the read policies
  are public because congressional voting records are public record).

  CONGRESS_API_KEY is optional but recommended: without it, House members show
  their state instead of their district number, because the Supabase roster
  stores district as NULL and only Congress.gov can fill it in. Free key:
  https://api.congress.gov/sign-up/

  FEC_API_KEY is optional for development; the app falls back to OpenFEC's
  lower-rate DEMO_KEY. A free project key prevents rate limits in normal use:
  https://api.data.gov/signup/
-->
<plist version="1.0">
<dict>
	<key>SUPABASE_URL</key>
	<string>YOUR_SUPABASE_URL</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>YOUR_SUPABASE_ANON_KEY</string>
	<key>CONGRESS_API_KEY</key>
	<string>YOUR_CONGRESS_API_KEY</string>
	<key>FEC_API_KEY</key>
	<string>YOUR_FEC_API_KEY</string>
</dict>
</plist>
