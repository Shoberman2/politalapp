# =============================================================================
# Political Vote Tracker - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Congress.gov API (Required for ETL)
# -----------------------------------------------------------------------------
# Get your free API key at: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=your_congress_api_key_here

# For frontend (Vite requires VITE_ prefix)
VITE_CONGRESS_API_KEY=your_congress_api_key_here

# -----------------------------------------------------------------------------
# Supabase (Required for ETL and Frontend)
# -----------------------------------------------------------------------------
# Get these from your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# For frontend (anon key, safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# For serverless API routes that validate Supabase user JWTs.
# If omitted, routes fall back to VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=your_anon_key_here

# Google sign-in uses Supabase Auth Providers > Google.
# In Google Cloud, add the Supabase callback URL as an authorized redirect URI:
# https://your-project.supabase.co/auth/v1/callback
# In Supabase Auth URL configuration, allow app redirects such as:
# http://localhost:5173/**
# http://localhost:3000/**
# https://www.ballotwatch.io/**

# -----------------------------------------------------------------------------
# AI Services (Optional - for bill summaries)
# -----------------------------------------------------------------------------
# Server-side only. Do not expose OpenAI keys with a VITE_ prefix.
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Campaign Finance APIs (Optional - for donation tracking)
# -----------------------------------------------------------------------------
# FEC API - DEMO_KEY works but has rate limits
# Get a key at: https://api.open.fec.gov/developers/
VITE_FEC_API_KEY=DEMO_KEY

# OpenSecrets API - for industry/sector breakdown
# Get your free key at: https://www.opensecrets.org/api/admin/index.php?function=signup
VITE_OPENSECRETS_API_KEY=your_opensecrets_api_key_here

# -----------------------------------------------------------------------------
# Stripe (Required for subscriptions)
# -----------------------------------------------------------------------------
# Get these from your Stripe Dashboard
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# -----------------------------------------------------------------------------
# Civic Briefing Gmail Delivery (Required for /briefings email updates)
# -----------------------------------------------------------------------------
# Create a Google OAuth web app and enable the Gmail API.
# Authorized redirect URI should match your deployment, for example:
# https://www.ballotwatch.io/api/briefings/gmail/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Use the Vercel dev/serverless origin locally, not the plain Vite origin.
GMAIL_REDIRECT_URI=http://localhost:3000/api/briefings/gmail/callback

# 32 random bytes, base64 encoded. Example:
# openssl rand -base64 32
GMAIL_TOKEN_ENCRYPTION_KEY=base64_32_byte_secret

# Used by Vercel Cron when invoking /api/briefings/cron.
CRON_SECRET=your_cron_secret

# -----------------------------------------------------------------------------
# ETL Configuration (Optional)
# -----------------------------------------------------------------------------
# Number of days of vote history to fetch (default: 7)
ETL_DAYS_BACK=7

# Maximum number of votes to process per run (default: 100)
ETL_MAX_VOTES=100

# Set to 'true' to run in dry-run mode (no DB writes)
ETL_DRY_RUN=false

# -----------------------------------------------------------------------------
# Feature flags (Bills sponsor + routing — migration 006)
# -----------------------------------------------------------------------------
# Default OFF. Flip to 'true' in Vercel env after migration 006 is applied
# and Phase A backfill (sponsor + routings + cosponsors for current Congress)
# has completed.
#
# Gates:
#   - BillsPage sponsor + cosponsor filter pills
#   - SearchBillsInDb cosponsor join (no perf cost when false)
#   - PoliticianDetail sponsor activity badge
VITE_BILLS_SHOW_SPONSOR_FILTER=false

# Gates:
#   - BillDetail "Where this bill goes" routing panel
#   - Smart status pill survival popover (default pill stays a plain label)
#   - /committee/:code route registration (catch-all redirect when off)
VITE_BILLS_SHOW_ROUTING_PANEL=false

# Historical chamber routes ship enabled. Set to false only to hide the
# feature temporarily without reverting a deployment.
VITE_SHOW_CHAMBER=true

# Required by /api/metrics/inc.js — must equal the deployed origin
# (e.g. https://www.ballotwatch.io). When unset, the Origin check is
# disabled in dev but logs a warning.
VITE_PUBLIC_ORIGIN=http://localhost:3000
