{
  "name": "political-voting-tracker",
  "private": true,
  "version": "0.9.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fullstack": "vercel dev --listen 3000",
    "config:check": "node scripts/check-config.mjs",
    "config:check:full": "node scripts/check-config.mjs --full",
    "prebuild": "node scripts/sync-openapi.mjs && node scripts/build-llms-full.mjs",
    "data:export": "npx tsx etl/exportOpenData.ts",
    "data:publish": "npx tsx etl/exportOpenData.ts --upload",
    "build": "vite build",
    "preview": "vite preview",
    "data:voteview-ideology": "node scripts/update-voteview-ideology.mjs",
    "etl": "npx tsx etl/run.ts",
    "etl:dry-run": "npx tsx etl/run.ts --dry-run",
    "etl:enrich": "npx tsx etl/run.ts --enrich-only",
    "etl:verbose": "npx tsx etl/run.ts --verbose",
    "alerts:run": "tsx etl/runBillAlerts.ts",
    "etl:backfill-sponsors": "npx tsx etl/backfillSponsorAndRoutings.ts --phase a",
    "etl:backfill-historical-routings": "npx tsx etl/backfillSponsorAndRoutings.ts --phase b",
    "etl:compute-survival": "npx tsx etl/computeCommitteeSurvival.ts",
    "forecast:provenance": "tsx etl/forecast/runProvenanceAudit.ts etl/forecast/fixtures/provenance-118.json",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@stripe/stripe-js": "^10.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.3",
    "axios": "^1.20.0",
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "react-simple-maps": "^5.0.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^29.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^4.1.2"
  }
}
