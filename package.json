{
  "name": "political-voting-tracker",
  "private": true,
  "version": "0.3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fullstack": "vercel dev --listen 3000",
    "config:check": "node scripts/check-config.mjs",
    "config:check:full": "node scripts/check-config.mjs --full",
    "build": "vite build",
    "preview": "vite preview",
    "etl": "npx tsx etl/run.ts",
    "etl:dry-run": "npx tsx etl/run.ts --dry-run",
    "etl:enrich": "npx tsx etl/run.ts --enrich-only",
    "etl:verbose": "npx tsx etl/run.ts --verbose",
    "alerts:run": "tsx etl/runBillAlerts.ts",
    "etl:backfill-sponsors": "npx tsx etl/backfillSponsorAndRoutings.ts --phase a",
    "etl:backfill-historical-routings": "npx tsx etl/backfillSponsorAndRoutings.ts --phase b",
    "etl:compute-survival": "npx tsx etl/computeCommitteeSurvival.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/og": "^0.11.1",
    "axios": "^1.6.7",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.22.0",
    "react-simple-maps": "^3.0.0",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^29.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^4.1.2"
  }
}
