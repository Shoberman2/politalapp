{
  "rewrites": [
    { "source": "/s/bill/:congress/:billType/:number", "destination": "/api/share?bill=:congress-:billType-:number" },
    { "source": "/((?!api/|assets/|s/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
