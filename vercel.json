{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/briefings/cron",
      "schedule": "0 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "politicalapp.vercel.app"
        }
      ],
      "destination": "https://www.ballotwatch.io/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "politicalapp-git-main-shoberman2s-projects.vercel.app"
        }
      ],
      "destination": "https://www.ballotwatch.io/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/politician/:bioguideId/record",
      "destination": "/api/prerender?kind=record&id=:bioguideId"
    },
    {
      "source": "/politician/:bioguideId",
      "destination": "/api/prerender?kind=member&id=:bioguideId"
    },
    {
      "source": "/bill/:congress/:type/:number",
      "destination": "/api/prerender?kind=bill&congress=:congress&type=:type&number=:number"
    },
    {
      "source": "/vote/:congress/:chamber/:session/:roll",
      "destination": "/api/prerender?kind=vote&congress=:congress&chamber=:chamber&session=:session&roll=:roll"
    },
    {
      "source": "/",
      "destination": "/api/prerender?kind=home"
    },
    {
      "source": "/:page(how-it-works|methodology|data-sources|about|this-week|offices|contact|privacy|terms|open)",
      "destination": "/api/prerender?kind=static&page=:page"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-:part.xml",
      "destination": "/api/sitemap?part=:part"
    },
    {
      "source": "/api/proxy/congress/:path*",
      "destination": "/api/proxy/congress?path=:path*"
    },
    {
      "source": "/api/proxy/fec/:path*",
      "destination": "/api/proxy/fec?path=:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/server-card",
      "destination": "/.well-known/mcp/server-card.json"
    },
    {
      "source": "/data/full/:path*",
      "destination": "https://dbtbmjjjcfwobhlicduk.supabase.co/storage/v1/object/public/open-data/latest/:path*"
    },
    {
      "source": "/data/archive/:date(\\d{4}-\\d{2}-\\d{2})/:path*",
      "destination": "https://dbtbmjjjcfwobhlicduk.supabase.co/storage/v1/object/public/open-data/:date/:path*"
    },
    {
      "source": "/s/bill/:congress/:billType/:number",
      "destination": "/api/share?bill=:congress-:billType-:number"
    },
    {
      "source": "/((?!api/|assets/|s/|@vite/|@react-refresh|src/|node_modules/|etl/|shared/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/openapi.yaml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/yaml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/data/full/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=900, stale-while-revalidate=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/data/archive/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/mcp/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
